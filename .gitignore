# generated cache: jsDelivr fallback index, github repo -> website map
.cache/
src/.cache/

# secrets — SCOOP_AZURE_KEY, GITHUB_TOKEN live here
.env
src/.env

*.log

# built URI handler binary
handler/pkgproxy.exe
handler/*.exe

# generated Windows version resource (goversioninfo); exactly one .syso may sit
